      "level": 2,
      "text": "一、核心组件/概念"
    },
    {
      "level": 2,
      "text": "二、消息流程"
    },
    {
      "level": 3,
      "text": "生产者发送消息"
    },
    {
      "level": 3,
      "text": "Leader 处理消息"
    },
    {
      "level": 3,
      "text": "Leader 返回 ACK"
    },
    {
      "level": 3,
      "text": "消费者拉取消息"
    },
    {
      "level": 3,
      "text": "消费者返回 offset"
    },
    {
      "level": 3,
      "text": "Broker 维护 offset"
    },
    {
      "level": 2,
      "text": "三、优劣分析"
    },
    {
      "level": 3,
      "text": "（一）优点"
    },
    {
      "level": 4,
      "text": "极致的高吞吐"
    },
    {
      "level": 4,
      "text": "的高扩展性"
    },
    {
      "level": 4,
      "text": "高可用性机制"
    },
    {
      "level": 4,
      "text": "消息持久化与可回溯"
    },
    {
      "level": 3,
      "text": "（二）缺点"
    },
    {
      "level": 4,
      "text": "全局顺序消息的瓶颈"
    },
    {
      "level": 4,
      "text": "事务支持较弱"
    },
    {
      "level": 4,
      "text": "无法应对场景"
    },
    {
      "level": 4,
      "text": "存在漏消费或者重复消费问题"
    },
    {
      "level": 4,
      "text": "对小消息的处理效率较低"
    },
