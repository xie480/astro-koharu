  "headings": [
    {
      "level": 2,
      "text": "一、什么是慢查询？"
    },
    {
      "level": 2,
      "text": "二、如何定位？"
    },
    {
      "level": 3,
      "text": "（一）通过临时开启"
    },
    {
      "level": 3,
      "text": "（二）通过永久开启"
    },
    {
      "level": 3,
      "text": "(三）测试日志是否正常工作"
    },
    {
      "level": 3,
      "text": "（四）分析日志"
    },
    {
      "level": 2,
      "text": "三、慢查询常见原因"
    },
    {
      "level": 2,
      "text": "四、优化思路"
    },
    {
      "level": 3,
      "text": "（一）索引"
    },
    {
      "level": 4,
      "text": "原因其一：未设置索引"
    },
    {
      "level": 4,
      "text": "原因其二：索引失效"
    },
    {
      "level": 4,
      "text": "原因其三： 索引覆盖不全"
    },
    {
      "level": 3,
      "text": "（二）SQL 语句"
    },
    {
      "level": 4,
      "text": "原因其一： 返回结果存在冗余字段"
    },
    {
      "level": 4,
      "text": "原因其二： 子查询"
    },
    {
      "level": 4,
      "text": "原因其三： 多表 JOIN 过多"
    },
    {
      "level": 4,
      "text": "原因其四： 避免排序"
    },
    {
      "level": 4,
      "text": "原因其五： 避免使用 NOT IN 和 !="
    },
    {
      "level": 3,
      "text": "（三）数据量级"
    },
    {
      "level": 3,
      "text": "（四）表结构"
    },
    {
      "level": 4,
      "text": "原因其一：未设置主键"
    },
    {
      "level": 4,
      "text": "原因其二： 反范式过度"
    },
    {
      "level": 4,
      "text": "原因其三： 未使用小字段替换大字段"
    },
    {
      "level": 4,
      "text": "原因其四： 未分库分表"
    },
    {
      "level": 4,
      "text": "原因其五： 大字段位于热点字段表中"
    },
    {
      "level": 3,
      "text": "（五）业务逻辑问题"
    },
    {
      "level": 4,
      "text": "原因其一：未使用批量 SQL"
    },
    {
      "level": 4,
      "text": "原因其二： 未使用多线程并行处理"
    },
    {
      "level": 3,
      "text": "（六）参数设置问题"
    }
  ],
