  "headings": [
    {
      "level": 2,
      "text": "一、上下文工程到底为什么重要"
    },
    {
      "level": 3,
      "text": "（一）从几个真实的工程症状说起"
    },
    {
      "level": 3,
      "text": "（二）为什么在 Agent 时代，上下文会取代 Prompt 成为核心问题"
    },
    {
      "level": 3,
      "text": "（三）为什么很多 Agent 项目在原型阶段顺利，在生产阶段失速"
    },
    {
      "level": 2,
      "text": "二、什么是上下文工程"
    },
    {
      "level": 3,
      "text": "（一）定义"
    },
    {
      "level": 3,
      "text": "（二）上下文的组成"
    },
    {
      "level": 3,
      "text": "（三）上下文的"
    },
    {
      "level": 3,
      "text": "（四）分层理解上下文"
    },
    {
      "level": 2,
      "text": "三、为什么上下文会成为 Agent 的第一性约束"
    },
    {
      "level": 3,
      "text": "（一）模型不是在思考世界，而是在思考你给它的世界"
    },
    {
      "level": 3,
      "text": "（二）上下文窗口不是唯一约束，注意力稀释更关键"
    },
    {
      "level": 3,
      "text": "（三）状态缺失，是很多 Agent 不稳定的真正原因"
    },
    {
      "level": 3,
      "text": "（四）知识、状态、记忆，三者必须分开治理"
    },
    {
      "level": 2,
      "text": "四、架构演进"
    },
    {
      "level": 3,
      "text": "（一）第一阶段：单轮 Prompt 驱动"
    },
    {
      "level": 3,
      "text": "（二）第二阶段：RAG 增强"
    },
    {
      "level": 3,
      "text": "（三）第三阶段：Tool Use 与 Memory"
    },
    {
      "level": 3,
      "text": "（四）第四阶段：Planner、State、Workflow"
    },
    {
      "level": 3,
      "text": "（五）第五阶段：上下文操作系统"
    },
    {
      "level": 2,
      "text": "五、主流方案"
    },
    {
      "level": 3,
      "text": "（一）直接拼接历史对话"
    },
    {
      "level": 3,
      "text": "（二）RAG"
    },
    {
      "level": 3,
      "text": "（三）Memory"
    },
    {
      "level": 3,
      "text": "（四）显式 State"
    },
    {
      "level": 3,
      "text": "（五）工具返回结果作为上下文"
    },
    {
      "level": 3,
      "text": "（六）工作流编排"
    },
    {
      "level": 2,
      "text": "六、主流架构的详细对比"
    },
    {
      "level": 3,
      "text": "（一）模型中心架构"
    },
    {
      "level": 3,
      "text": "（二）系统中心架构"
    },
    {
      "level": 3,
      "text": "（三）链式架构与图式架构"
    },
    {
      "level": 3,
      "text": "（四）单 Agent 架构与多 Agent 架构"
    },
    {
      "level": 2,
      "text": "七、生产实践"
    },
    {
      "level": 3,
      "text": "（一）把上下文组装器做成独立层"
    },
    {
      "level": 3,
      "text": "（二）上下文供给流程"
    },
    {
      "level": 3,
      "text": "（三）会话摘要"
    },
    {
      "level": 3,
      "text": "（四）知识召回"
    },
    {
      "level": 3,
      "text": "（五）工具结果"
    },
    {
      "level": 3,
      "text": "（六）可观测性设计"
    },
    {
      "level": 2,
      "text": "八、常见坑"
    },
    {
      "level": 3,
      "text": "（一）上下文膨胀"
