  "headings": [
    {
      "level": 2,
      "text": "一、为什么很重要"
    },
    {
      "level": 2,
      "text": "二、提示词工程是什么"
    },
    {
      "level": 3,
      "text": "（一）提示词不只是文本输入，而是模型行为接口"
    },
    {
      "level": 3,
      "text": "（二）在 Agent 架构里，提示词与上下文、工具、记忆共同工作"
    },
    {
      "level": 3,
      "text": "（三）提示词工程追求的是系统稳定性"
    },
    {
      "level": 2,
      "text": "三、提示词工程的架构演进"
    },
    {
      "level": 3,
      "text": "（一）第一阶段：静态 Prompt 驱动的单轮应用"
    },
    {
      "level": 3,
      "text": "（二）第二阶段"
    },
    {
      "level": 3,
      "text": "（三）第三阶段：工具调用"
    },
    {
      "level": 3,
      "text": "（四）第四阶段：受控编排"
    },
    {
      "level": 2,
      "text": "四、Agent 场景中常见的提示词架构"
    },
    {
      "level": 3,
      "text": "（一）单体式 Prompt"
    },
    {
      "level": 3,
      "text": "（二）分层式 Prompt"
    },
    {
      "level": 3,
      "text": "（三）Planner-Executor 架构"
    },
    {
      "level": 3,
      "text": "（四）Workflow Agent"
    },
    {
      "level": 2,
      "text": "五、主流实现路径与生态框架"
    },
    {
      "level": 3,
      "text": "（一）从手写到框架编排"
    },
    {
      "level": 3,
      "text": "（二）几类主流框架的适用边界"
    },
    {
      "level": 3,
      "text": "（三）模型原生工具调用能力正在改变提示词工程的重点"
    },
    {
      "level": 2,
      "text": "六、核心实践"
    },
    {
      "level": 3,
      "text": "（一）先定义任务边界，再写提示词"
    },
    {
      "level": 3,
      "text": "（二）把提示词当配置与代码之间的中间层管理"
    },
    {
      "level": 3,
      "text": "（三）少依赖文案技巧，多依赖结构化约束"
    },
    {
      "level": 3,
      "text": "（四）控制上下文长度，比追求长提示词更重要"
    },
    {
      "level": 3,
      "text": "（五）Few-shot 示例要少而准，不要把提示词写成训练集"
    },
    {
      "level": 2,
      "text": "七、一套更稳的 Agent 提示词设计方法"
    },
    {
      "level": 3,
      "text": "（一）推荐采用分层 Prompt + 工作流控制 + 结构化输出"
    },
    {
      "level": 3,
      "text": "（二）提示词设计应围绕失败场景，而不只是成功路径"
    },
    {
      "level": 2,
      "text": "八、常见坑"
    },
    {
      "level": 3,
      "text": "（一）把知识缺失误判为提示词问题"
    },
    {
      "level": 3,
      "text": "（二）把工具可靠性问题转嫁给提示词"
    },
    {
      "level": 3,
      "text": "（三）在一个 Prompt 里混合互相冲突的目标"
    },
    {
      "level": 3,
      "text": "（四）忽视模型差异，默认 Prompt 可跨模型迁移"
    },
    {
      "level": 2,
      "text": "九、设计范式"
    },
    {
      "level": 3,
      "text": "（一）把 Agent 拆成可测节点，而不是追求万能自治"
    },
    {
      "level": 3,
      "text": "（二）用 Prompt 表达策略，用程序表达规则"
    },
    {
      "level": 3,
      "text": "（三）提示词工程最终会走向系统工程"
    },
    {
      "level": 2,
      "text": "十、总结"
    }
  ],
