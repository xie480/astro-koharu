---
import SakuraSVG from '@components/svg/SakuraSvg';
import { MAX_WIDTH } from '@constants/layout';
import { icpConfig, siteConfig } from '@constants/site-config';
import { identityConfig } from '@lib/config/site';
import { cn } from '@lib/utils';
import { getLocaleFromUrl, localizedPath } from '@/i18n';

interface Props {
  className?: string;
}
const { className } = Astro.props;
const locale = getLocaleFromUrl(Astro.url.pathname);
const currentYear = new Date().getFullYear();
const startYear = siteConfig.startYear ?? currentYear;
const messageParts = identityConfig.footerMessage.split(/([♥❤]️?)/u);
---
<footer class={cn('site-footer mt-auto px-5 pt-14 pb-10 tablet:pb-24', className)}>
  <div class={cn('mx-auto flex flex-col items-center gap-5 text-center', MAX_WIDTH.content)}>
    <animated-footer class="footer-motto-wrap">
      <span class="footer-petal footer-petal-first" aria-hidden="true"><SakuraSVG /></span>
      <span class="footer-petal footer-petal-last" aria-hidden="true"><SakuraSVG /></span>
      <p class="footer-motto text-xl font-semibold leading-relaxed">
        <span class="sr-only">{identityConfig.footerMessage}</span>
        <span aria-hidden="true">{messageParts.map((part) => <span class={/[♥❤]/u.test(part) ? 'footer-heart' : 'footer-shine'}>{part}</span>)}</span>
      </p>
      <button type="button" class="footer-motion-toggle" data-footer-toggle hidden aria-label="暂停页尾动画" aria-pressed="false" title="暂停页尾动画"><span aria-hidden="true">Ⅱ</span></button>
    </animated-footer>
    <div class="text-muted-foreground flex flex-wrap items-center justify-center gap-x-2 gap-y-3 text-sm">
      <span>© {startYear}{startYear !== currentYear ? `–${currentYear}` : ''} {siteConfig.name}. All Rights Reserved.</span>
      <nav aria-label="订阅与网站地图" class="flex flex-wrap items-center justify-center gap-3">
        <a href={localizedPath('/rss.xml', locale)} class="footer-link">RSS</a>
        <span aria-hidden="true">/</span>
        <a href={localizedPath('/atom.xml', locale)} class="footer-link">Atom</a>
        <span aria-hidden="true">/</span>
        <a href="/sitemap-index.xml" class="footer-link">Sitemap</a>
      </nav>
    </div>
    {icpConfig && <p class="text-muted-foreground text-sm">{icpConfig.link ? <a href={icpConfig.link} target="_blank" rel="noopener noreferrer" class="footer-link">{icpConfig.text}</a> : icpConfig.text}</p>}
  </div>
</footer>

<script>
  import { readMotionLevel, subscribeMotionLevel } from '@lib/motion-level';

  class AnimatedFooter extends HTMLElement {
    private abort?: AbortController;
    private observer?: IntersectionObserver;
    private unsubscribe?: () => void;
    private inView = false;
    private paused = false;

    connectedCallback() {
      this.disconnectedCallback();
      this.abort = new AbortController();
      const { signal } = this.abort;
      const button = this.querySelector<HTMLButtonElement>('[data-footer-toggle]');
      button?.removeAttribute('hidden');
      button?.addEventListener('click', () => {
        this.paused = !this.paused;
        this.sync();
      }, { signal });
      document.addEventListener('visibilitychange', () => this.sync(), { signal });
      document.addEventListener('astro:before-swap', () => this.disconnectedCallback(), { signal });
      this.unsubscribe = subscribeMotionLevel(() => this.sync());
      if (typeof IntersectionObserver === 'undefined') {
        this.inView = true;
      } else {
        this.inView = false;
        this.observer = new IntersectionObserver(([entry]) => {
          if (signal.aborted) return;
          this.inView = entry.isIntersecting;
          this.sync();
        });
        this.observer.observe(this);
      }
      this.sync();
    }

    private sync() {
      if (!this.isConnected || this.abort?.signal.aborted) return;
      const reduced = readMotionLevel() === 'reduced';
      this.toggleAttribute('data-playing', !reduced && !this.paused && this.inView && !document.hidden);
      this.toggleAttribute('data-reduced', reduced);
      const button = this.querySelector<HTMLButtonElement>('[data-footer-toggle]');
      if (!button) return;
      const label = reduced ? '减少动效模式已关闭页尾动画' : this.paused ? '继续页尾动画' : '暂停页尾动画';
      button.disabled = reduced;
      button.setAttribute('aria-pressed', String(reduced || this.paused));
      button.setAttribute('aria-label', label);
      button.title = label;
      const symbol = button.querySelector('span');
      if (symbol) symbol.textContent = reduced || this.paused ? '▶' : 'Ⅱ';
    }

    disconnectedCallback() {
      this.abort?.abort();
      this.observer?.disconnect();
      this.unsubscribe?.();
      this.unsubscribe = undefined;
      this.removeAttribute('data-playing');
    }
  }

  if (!customElements.get('animated-footer')) customElements.define('animated-footer', AnimatedFooter);
</script>

<style>
  .footer-motto-wrap {
    --footer-play-state: paused;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    max-width: 100%;
    padding: 1.25rem 2.5rem;
  }
  .footer-motto-wrap[data-playing] { --footer-play-state: running; }
  .footer-motto { color: hsl(var(--primary)); letter-spacing: .08em; text-wrap: balance; }
  .footer-shine {
    background: linear-gradient(100deg, #c44265 0%, #bd5080 20%, #337a8b 40%, #c44265 60%, #bd5080 80%, #337a8b 100%);
    background-size: 200% auto;
    background-clip: text;
    color: transparent;
    animation: footer-shine 4s linear infinite;
    animation-play-state: var(--footer-play-state);
  }
  :global(.dark) .footer-shine {
    background-image: linear-gradient(100deg, #ff91ab 0%, #efa2cb 20%, #88dce4 40%, #ff91ab 60%, #efa2cb 80%, #88dce4 100%);
  }
  .footer-heart {
    display: inline-block;
    margin-inline: .25em;
    color: #e95473;
    text-shadow: 0 0 12px #ff6b8180;
    animation: footer-heartbeat 1.5s ease-in-out infinite;
    animation-play-state: var(--footer-play-state);
  }
  .footer-petal {
    position: absolute;
    width: 1rem;
    height: 1rem;
    color: #ed87a0;
    opacity: .3;
    pointer-events: none;
    animation: footer-petal-float 6s ease-in-out infinite alternate;
    animation-play-state: var(--footer-play-state);
  }
  .footer-petal-first { top: .15rem; left: 6%; }
  .footer-petal-last { right: 8%; bottom: .1rem; animation-duration: 8s; animation-delay: -3s; }
  .footer-motion-toggle {
    position: absolute;
    right: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: hsl(var(--muted-foreground));
    background: hsl(var(--primary) / .06);
    font-size: .75rem;
    cursor: pointer;
  }
  .footer-motion-toggle[hidden] { display: none; }
  .footer-motion-toggle:hover { color: hsl(var(--primary)); background: hsl(var(--primary) / .12); }
  .footer-motion-toggle:disabled { opacity: .5; cursor: default; }
  .footer-link { color: color-mix(in srgb, hsl(var(--primary)) 50%, hsl(var(--foreground))); text-underline-offset: .25em; }
  .footer-link:hover { text-decoration: underline; }
  .footer-link:focus-visible, .footer-motion-toggle:focus-visible {
    outline: 2px solid hsl(var(--primary));
    outline-offset: 4px;
    border-radius: .25rem;
  }
  [data-reduced] :is(.footer-shine, .footer-heart, .footer-petal) { animation: none; }
  [data-reduced] .footer-shine { background: none; color: hsl(var(--primary)); }
  [data-reduced] .footer-heart { text-shadow: none; }
  :global(html[data-motion='subtle']) .footer-petal { animation: none; }
  :global(html[data-motion='subtle']) .footer-heart { animation-duration: 3s; }
  @keyframes footer-shine { to { background-position: 200% center; } }
  @keyframes footer-heartbeat { 50% { transform: scale(1.2); text-shadow: 0 0 16px #ff6b81a0; } }
  @keyframes footer-petal-float {
    to { transform: translate(1rem, -.625rem) rotate(45deg); opacity: .5; }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-shine, .footer-heart, .footer-petal { animation: none; }
    .footer-heart { text-shadow: none; }
  }
</style>
