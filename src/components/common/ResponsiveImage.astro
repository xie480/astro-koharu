---
import { Picture } from 'astro:assets';
import { resolveResponsiveImage, responsiveImageQuality } from '@lib/responsive-image';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'img'> {
  src: string;
  alt: string;
  maxWidth?: number;
}

const { src, alt, maxWidth = 1600, ...attributes } = Astro.props;
const image = await resolveResponsiveImage(src, maxWidth);
const referrerPolicy = attributes.referrerpolicy ?? (/^(?:https?:)?\/\//i.test(src) ? 'no-referrer' : undefined);
---

{image ? (
  <Picture
    {...attributes}
    referrerpolicy={referrerPolicy}
    src={image.src}
    alt={alt}
    width={image.width}
    height={undefined}
    widths={image.widths}
    formats={['avif']}
    fallbackFormat="webp"
    quality={responsiveImageQuality}
    pictureAttributes={{ class: 'contents' }}
  />
) : <img {...attributes} referrerpolicy={referrerPolicy} src={src} alt={alt} />}
